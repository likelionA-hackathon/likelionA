# ── DB (Neon Postgres) ───────────────────────────────────────────
# Neon 콘솔 → Connect 버튼 → 두 문자열을 각각 복사한다.
#
#   DATABASE_URL : 호스트에 "-pooler" 가 붙은 것 (Connection pooling 체크됨) ← 앱이 씀
#   DIRECT_URL   : "-pooler" 가 없는 것 (Connection pooling 체크 해제)      ← prisma db push 가 씀
#
# 팀 전원이 같은 값을 씁니다. 각자 만들면 화면 붙일 때 id 가 안 맞습니다.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth (전철우) ─────────────────────────────────────────────
# openssl rand -base64 32  또는  npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹)
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── AI (백지우) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=""
# 요약/정규화는 빠르고 싼 모델로 충분. 품질 아쉬우면 claude-sonnet-5 로 교체.
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# ── Notion (백지우) ───────────────────────────────────────────────
# https://www.notion.so/my-integrations → New integration → Internal Integration Token
# 그리고 대상 Notion 데이터베이스 페이지에서 "연결 추가"로 이 integration 을 초대해야 함
NOTION_TOKEN=""
NOTION_DATABASE_ID=""

# ── 개발 편의 ─────────────────────────────────────────────────────
# 로그인 붙기 전까지 API 를 열어두기 위한 스위치. 배포 전에 반드시 false.
DEV_AUTH_BYPASS="true"
# 로그인 없이 호출할 때 이 이메일의 사용자로 동작 (seed 로 생성됨)
DEV_USER_EMAIL="jiwoo@baton.dev"
