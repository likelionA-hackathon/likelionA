# ── DB (Neon Postgres) ───────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── NextAuth (전철우) ─────────────────────────────────────────────
# openssl rand -base64 32  또는  npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 클라이언트 ID(웹)
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── AI (백지우) ───────────────────────────────────────────────────
# 둘 중 하나만 있으면 됩니다. 둘 다 있으면 LLM_PROVIDER 로 고릅니다.
#
# [권장] Gemini — 무료 티어. 카드 등록 없이 https://aistudio.google.com/apikey 에서 발급
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
#
# Claude — 유료(신규 계정 무료 크레딧 있음). https://console.anthropic.com
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5-20251001"
#
# OpenAI 호환 엔드포인트 — 해커톤 크레딧을 받았다면 대개 여기에 붙습니다.
# OpenAI / Upstage Solar / Groq / Together / OpenRouter / FriendliAI /
# DeepSeek / xAI / Cerebras / Fireworks / 로컬 Ollama·vLLM 전부 이 한 갈래로 됩니다.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"   # 공급자가 준 base URL 로 교체
OPENAI_MODEL="gpt-5.6-luna"                   # 가장 저렴한 모델. 다른 공급자면 그쪽 모델명으로
#
# openai | gemini | anthropic  (비우면 있는 키를 자동으로 씁니다)
LLM_PROVIDER=""

# ── Notion (백지우) ───────────────────────────────────────────────
# https://www.notion.so/my-integrations → New integration → Internal Integration Token
# 그리고 대상 Notion 데이터베이스 페이지에서 "연결 추가"로 이 integration 을 초대해야 함
NOTION_TOKEN=""
NOTION_DATABASE_ID=""

# ── 개발 편의 ─────────────────────────────────────────────────────
# 로그인 붙기 전까지 API 를 열어두기 위한 스위치. 배포 전에 반드시 false.
DEV_AUTH_BYPASS="true"
# 로그인 없이 호출할 때 이 이메일의 사용자로 동작 (seed 로 생성됨)
DEV_USER_EMAIL="jiwoo@baton.dev"

# ── 데모 (심사용) ─────────────────────────────────────────────────
# 처음 로그인한 사용자를 데모 워크스페이스에 자동으로 넣습니다.
# 심사위원이 자기 Google 계정으로 들어와도 바로 데모 데이터를 볼 수 있습니다.
# 실서비스라면 반드시 꺼야 합니다.
DEMO_AUTO_JOIN="true"
DEMO_WORKSPACE_SLUG="settle-team"
# Google 계정 없이 둘러볼 수 있는 게스트 로그인 버튼
DEMO_GUEST_LOGIN="true"
DEMO_GUEST_EMAIL="guest@pmconnector.dev"
